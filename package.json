    "@vitejs/plugin-react": "^4.1.1",
    "vite": "^5.0.6",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "prettier": "^3.1.0",
    "@types/node": "^20.10.4",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.1",
    "@hardhat/hardhat-toolbox": "^4.0.0",
    "solidity-coverage": "^0.8.5",
    "hardhat-gas-reporter": "^1.0.9",
    "hardhat-contract-sizer": "^2.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lionsun-gaming/platform.git"
  },
  "bugs": {
    "url": "https://github.com/lionsun-gaming/platform/issues"
  },
  "homepage": "https://lionsun.game"
}
