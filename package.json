{
  "name": "lionsun-gaming-platform",
  "version": "2.0.0",
  "description": "Complete Lionsun gaming platform with cryptocurrency integration and NFT support",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:client && npm run build:contracts",
    "build:client": "vite build",
    "build:contracts": "npx hardhat compile",
    "test": "npm run test:backend && npm run test:frontend && npm run test:contracts",
    "test:backend": "jest tests/backend",
    "test:frontend": "vitest",
    "test:contracts": "npx hardhat test",
    "deploy:contracts": "npx hardhat run scripts/deploy.js --network polygon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker build -t lionsun-platform .",
    "docker:run": "docker run -p 3000:3000 lionsun-platform",
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all"
  },
  "keywords": [
    "gaming",
    "cryptocurrency", 
    "NFT",
    "blockchain",
    "web3",
    "mental-wellness",
    "cross-platform"
  ],
  "author": "Lionsun Gaming Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "nodemailer": "^6.9.7",
    "joi": "^17.11.0",
    "express-validator": "^7.0.1",
    "express-session": "^1.17.3",
    "connect-mongo": "^5.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-discord": "^0.1.4",
    "web3": "^4.3.0",
    "ethers": "^6.8.1",
    "@openzeppelin/contracts": "^5.0.0",
    "hardhat": "^2.19.1",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "ethereum-waffle": "^4.0.10",
    "chai": "^4.3.10",
    "@chainlink/contracts": "^0.8.0",
    "ipfs-http-client": "^60.0.1",
    "redis": "^4.6.11",
    "bull": "^4.12.2",
    "cron": "^3.1.6",
    "ws": "^8.14.2",
    "canvas": "^2.11.2",
    "node-canvas-api": "^2.11.2",
    "jimp": "^0.22.10",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "axios": "^1.6.2",
    "node-fetch": "^3.3.2",
    "cheerio": "^1.0.0-rc.12",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "uuid": "^9.0.1",
    "crypto-js": "^4.2.0",
    "stripe": "^14.9.0",
    "paypal-rest-sdk": "^1.8.1",
    "twilio": "^4.19.0",
    "discord.js": "^14.14.1",
    "twitter-api-v2": "^1.15.1",
    "instagram-basic-display-api": "^1.0.0",
    "youtube-api": "^3.0.1",
    "sequelize": "^6.35.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize-cli": "^6.6.2"
  },
  "devDependencies": {
