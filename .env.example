# Lionsuncoin Gaming Platform Environment Configuration

# Application Settings
NODE_ENV=development
PORT=3000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/lionsuncoin
# For production, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lionsuncoin

# Authentication & Security
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Redis Configuration (Optional - for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Email Configuration (For password reset, notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@lionsuncoin.game

# Blockchain Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-infura-project-id
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key-for-transactions
LIONSUNCOIN_CONTRACT_ADDRESS=0x...your-contract-address

# External APIs
COINGECKO_API_KEY=your-coingecko-api-key
MORALIS_API_KEY=your-moralis-api-key

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# Rate Limiting
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION=60

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Analytics & Monitoring
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Social Login (Optional)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Game Configuration
MIN_BET_AMOUNT=1
MAX_BET_AMOUNT=1000
HOUSE_EDGE=0.02
DEFAULT_STARTING_COINS=1000

# Platform-specific Settings
IOS_APP_ID=your-ios-app-id
ANDROID_PACKAGE_NAME=com.lionsuncoin.gaming
PS5_INTEGRATION_KEY=your-ps5-integration-key

# Development Settings
DEBUG=lionsuncoin:*
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3000

# Production Settings (Only for production deployment)
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/private.key
# ENABLE_CLUSTERING=true
# CLUSTER_WORKERS=4

# CDN Configuration (For static assets)
# CDN_URL=https://cdn.lionsuncoin.game
# AWS_S3_BUCKET=lionsuncoin-assets
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# Push Notifications
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_PRIVATE_KEY=your-firebase-private-key
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Backup Configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *
# BACKUP_RETENTION_DAYS=30