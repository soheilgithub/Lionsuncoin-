# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (for production use)
MONGODB_URI=mongodb://localhost:27017/lionsuncoin
DATABASE_URL=mongodb://localhost:27017/lionsuncoin

# JWT Configuration
JWT_SECRET=lionsuncoin_secret_key_2024_change_in_production
JWT_EXPIRATION=24h

# Client Configuration
CLIENT_URL=http://localhost:3000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Social Authentication (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Payment Integration (optional for real cryptocurrency)
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Blockchain Configuration (optional for real crypto)
ETHEREUM_NETWORK=ropsten
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key
CONTRACT_ADDRESS=your-smart-contract-address

# Analytics (optional)
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX-X

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
HELMET_CSP_ENABLED=true
COOKIE_SECRET=your-cookie-secret-key

# Gaming Configuration
DEFAULT_STARTING_COINS=1000
MAX_BET_AMOUNT=10000
LEVEL_UP_THRESHOLD=1000

# Platform Detection
SUPPORTED_PLATFORMS=web,ios,android,windows,linux,ps5