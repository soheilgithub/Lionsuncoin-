# Lionsun Gaming Platform - Environment Configuration
# Copy this file to .env and fill in your actual values

# ================================
# SERVER CONFIGURATION
# ================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ================================
# DATABASE CONFIGURATION
# ================================
# MongoDB
MONGODB_URI=mongodb://localhost:27017/lionsuncoin

# PostgreSQL (if using Sequelize)
DATABASE_URL=postgresql://username:password@localhost:5432/lionsun_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lionsun_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ================================
# SECURITY CONFIGURATION
# ================================
JWT_SECRET=your-super-secure-jwt-secret-key-here-minimum-32-characters
JWT_EXPIRE=24h
BCRYPT_ROUNDS=12

# Session Secret
SESSION_SECRET=your-session-secret-key-here

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://lionsun.game,https://www.lionsun.game

# ================================
# BLOCKCHAIN CONFIGURATION
# ================================
# Private Keys (NEVER commit these to version control!)
PRIVATE_KEY=your_wallet_private_key_here
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# RPC URLs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# API Keys
INFURA_API_KEY=your_infura_project_id
ALCHEMY_API_KEY=your_alchemy_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Contract Addresses (set after deployment)
LC_CONTRACT_ADDRESS=0x...
NFT_CONTRACT_ADDRESS=0x...
GOVERNANCE_CONTRACT_ADDRESS=0x...

# Gas Configuration
GAS_PRICE=25000000000
GAS_LIMIT=500000

# ================================
# IPFS CONFIGURATION
# ================================
IPFS_PROJECT_ID=your_ipfs_project_id
IPFS_PROJECT_SECRET=your_ipfs_project_secret
IPFS_GATEWAY=https://ipfs.io/ipfs/

# ================================
# REDIS CONFIGURATION
# ================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# ================================
# EMAIL CONFIGURATION
# ================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# SendGrid (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@lionsun.game
FROM_NAME=Lionsun Gaming

# ================================
# SOCIAL MEDIA INTEGRATION
# ================================
# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_GUILD_ID=your_discord_server_id

# Twitter API
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key

# ================================
# PAYMENT PROCESSING
# ================================
# Stripe
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# ================================
# CLOUD STORAGE
# ================================
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=lionsun-assets

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_KEYFILE=path/to/your/keyfile.json
GCS_BUCKET_NAME=lionsun-assets

# ================================
# MONITORING & ANALYTICS
# ================================
# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn

# Mixpanel Analytics
MIXPANEL_TOKEN=your_mixpanel_token

# CoinMarketCap (for gas reporting)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ================================
# EXTERNAL APIS
# ================================
# Chainlink Price Feeds
CHAINLINK_ETH_USD=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
CHAINLINK_MATIC_USD=0xAB594600376Ec9fD91F8e885dADF0CE036862dE0

# Moralis (Web3 API)
MORALIS_API_KEY=your_moralis_api_key

# Pinata (IPFS Pinning)
PINATA_JWT=your_pinata_jwt

# ================================
# OAUTH CONFIGURATION
# ================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ================================
# GAME CONFIGURATION
# ================================
# Game Rewards
LC_REWARD_MULTIPLIER=1.0
NFT_MINT_COOLDOWN=86400
MAX_DAILY_REWARDS=1000

# Level Configuration
MAX_LEVEL=50
XP_MULTIPLIER=1.0
DIFFICULTY_SCALING=1.2

# Staking Configuration
MIN_STAKE_AMOUNT=1000
STAKING_APY_BASE=500
STAKING_BONUS_MAX=1200

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESSFUL=true

# ================================
# LOGGING CONFIGURATION
# ================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE_PATH=logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ================================
# SECURITY HEADERS
# ================================
HELMET_CSP_DIRECTIVES=default-src 'self' https:; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:;

# ================================
# SSL/TLS CONFIGURATION
# ================================
SSL_CERT_PATH=path/to/ssl/cert.pem
SSL_KEY_PATH=path/to/ssl/key.pem
FORCE_HTTPS=false

# ================================
# DEVELOPMENT TOOLS
# ================================
# Enable debug features
DEBUG_MODE=true
ENABLE_SWAGGER=true
ENABLE_PLAYGROUND=true

# Hot reload
ENABLE_HOT_RELOAD=true

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/lionsun_test
JEST_TIMEOUT=30000

# ================================
# BACKUP CONFIGURATION
# ================================
BACKUP_ENABLED=true
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=lionsun-backups

# ================================
# LOCALIZATION
# ================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,ja,zh,ar,fa
TRANSLATION_API_KEY=your_translation_api_key

# ================================
# COMPLIANCE & LEGAL
# ================================
# KYC/AML
KYC_ENABLED=false
KYC_PROVIDER=jumio
KYC_API_KEY=your_kyc_api_key

# GDPR Compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=2555

# Terms Version
TERMS_VERSION=1.0
PRIVACY_POLICY_VERSION=1.0

# ================================
# PERFORMANCE MONITORING
# ================================
# New Relic
NEW_RELIC_LICENSE_KEY=your_new_relic_key
NEW_RELIC_APP_NAME=Lionsun Gaming Platform

# DataDog
DD_API_KEY=your_datadog_api_key
DD_APP_KEY=your_datadog_app_key

# ================================
# CDN CONFIGURATION
# ================================
CDN_URL=https://cdn.lionsun.game
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ================================
# MOBILE APP CONFIGURATION
# ================================
# Firebase (for push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Apple App Store
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# Google Play
GOOGLE_PLAY_KEY_FILE=path/to/google-play-key.json

# ================================
# DOMAIN CONFIGURATION
# ================================
DOMAIN=lionsun.game
API_DOMAIN=api.lionsun.game
FRONTEND_URL=https://lionsun.game
BACKEND_URL=https://api.lionsun.game

# ================================
# FEATURE FLAGS
# ================================
ENABLE_STAKING=true
ENABLE_NFT_MARKETPLACE=true
ENABLE_GOVERNANCE=false
ENABLE_MOBILE_APP=true
ENABLE_CONSOLE_GAMING=false
ENABLE_VR_MODE=false

# ================================
# WEBHOOK CONFIGURATION
# ================================
WEBHOOK_SECRET=your_webhook_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
DISCORD_WEBHOOK_URL=your_discord_webhook_url

# ================================
# COMMENTS & NOTES
# ================================
# Remember to:
# 1. Never commit .env files to version control
# 2. Use strong, unique passwords and keys
# 3. Rotate secrets regularly
# 4. Use environment-specific values for different deployments
# 5. Enable 2FA on all external service accounts
# 6. Monitor API usage and rate limits
# 7. Keep dependencies updated for security patches

# For production deployment:
# 1. Set NODE_ENV=production
# 2. Use production database URLs
# 3. Enable HTTPS and security headers
# 4. Configure proper CORS origins
# 5. Set up monitoring and logging
# 6. Configure backup strategies
# 7. Review and test all integrations